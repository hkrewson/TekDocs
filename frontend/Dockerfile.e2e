# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG PLAYWRIGHT_VERSION=1.62.1
FROM node:26.11.1-bookworm-slim@sha256:86f07bc9c5dce4578cf37e5a418b7bfc7f817cda25cde66e2b66e95ed86c4567 AS node-toolchain
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e

# Replace the Node runtime bundled in Playwright while retaining its matched browsers.
RUN apt-get purge -y nodejs && rm -rf /var/lib/apt/lists/*
COPY --from=node-toolchain /usr/local/ /usr/local/
RUN test "$(node --version)" = "v24.22.1"

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
