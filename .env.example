COMPOSE_PROJECT_NAME=tekdocs
POSTGRES_DB=tekdocs
POSTGRES_USER=tekdocs
POSTGRES_PASSWORD=generate-with-make-bootstrap
DJANGO_SECRET_KEY=generate-with-make-bootstrap
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3200
TEKDOCS_MASTER_KEY=generate-with-make-bootstrap
TEKDOCS_PUBLICATION_SIGNING_KEY=generate-with-make-bootstrap
TEKDOCS_BOOTSTRAP_TOKEN=generate-with-make-bootstrap
TEKDOCS_PUBLIC_URL=http://localhost:3200
TEKDOCS_ALLOW_INSECURE_PUBLIC_URL=true
# Leave every OIDC value empty to disable single sign-on. Configure all five together.
TEKDOCS_OIDC_PROVIDER_ID=
TEKDOCS_OIDC_PROVIDER_NAME=
TEKDOCS_OIDC_DISCOVERY_URL=
TEKDOCS_OIDC_CLIENT_ID=
TEKDOCS_OIDC_CLIENT_SECRET= # Set only when OIDC is enabled.
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TIMEOUT_SECONDS=3600
DJANGO_CACHE_URL=redis://valkey:6379/2
MAILPIT_UI_PORT=8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=TekDocs <noreply@tekdocs.local>
TEKDOCS_ALLOW_INSECURE_SMTP=true
SECURE_SSL_REDIRECT=false
TZ=America/Chicago
