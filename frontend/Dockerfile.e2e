# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG PLAYWRIGHT_VERSION=1.64.1
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS node-toolchain
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble@sha256:47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea AS browser

# Replace the Node runtime bundled in Playwright while retaining its matched browsers.
RUN apt-get purge -y nodejs && rm -rf /var/lib/apt/lists/*
COPY --from=node-toolchain /usr/local/ /usr/local/
RUN test "$(node --version)" = "v24.22.1"

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
