COMPOSE_PROJECT_NAME=tekdocs
TEKDOCS_DOMAIN=localhost
TEKDOCS_PROXY_NETWORK=proxy
TEKDOCS_TRAEFIK_ENTRYPOINT=http
TEKDOCS_SECRET_DIRECTORY=/absolute/path/to/TekDocs/secrets
POSTGRES_DB=tekdocs
POSTGRES_OWNER_USER=tekdocs
POSTGRES_OWNER_PASSWORD=generate-with-make-bootstrap
POSTGRES_RUNTIME_USER=tekdocs_runtime
POSTGRES_RUNTIME_PASSWORD=generate-with-make-bootstrap
DJANGO_SECRET_KEY=generate-with-make-bootstrap
DJANGO_ALLOWED_HOSTS=${TEKDOCS_DOMAIN},localhost,127.0.0.1,backend,tekdocs-backend,frontend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3200
TEKDOCS_MASTER_KEY=generate-with-make-bootstrap
TEKDOCS_PUBLICATION_SIGNING_KEY=generate-with-make-bootstrap
TEKDOCS_BOOTSTRAP_TOKEN=generate-with-make-bootstrap
TEKDOCS_PUBLIC_URL=http://localhost:3200
TEKDOCS_ALLOW_INSECURE_PUBLIC_URL=true
TEKDOCS_ALLOW_DEVELOPMENT_IMAGE=true
TEKDOCS_ATTACHMENT_SCANNER=apps.core.attachment_security.StrictAttachmentScanner
TEKDOCS_CLAMAV_HOST=clamav
TEKDOCS_CLAMAV_PORT=3310
TEKDOCS_CLAMAV_TIMEOUT=10
TEKDOCS_PUBLICATION_RETIRED_KEY_FINGERPRINTS=
TEKDOCS_RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
TEKDOCS_DOH_URL=
# Leave every OIDC value empty to disable single sign-on. Configure all five together.
TEKDOCS_OIDC_PROVIDER_ID=
TEKDOCS_OIDC_PROVIDER_NAME=
TEKDOCS_OIDC_DISCOVERY_URL=
TEKDOCS_OIDC_CLIENT_ID=
TEKDOCS_OIDC_CLIENT_SECRET= # Set only when OIDC is enabled.
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TIMEOUT_SECONDS=3600
DJANGO_CACHE_URL=redis://valkey:6379/2
MAILPIT_UI_PORT=8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=TekDocs <noreply@tekdocs.local>
TEKDOCS_ALLOW_INSECURE_SMTP=true
SECURE_SSL_REDIRECT=false
TZ=UTC
