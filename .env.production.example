COMPOSE_PROJECT_NAME=tekdocs
POSTGRES_DB=tekdocs
POSTGRES_OWNER_USER=tekdocs_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_RUNTIME_USER=tekdocs_runtime
POSTGRES_RUNTIME_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=docs.example.com,backend,frontend
DJANGO_CSRF_TRUSTED_ORIGINS=https://docs.example.com
TEKDOCS_MASTER_KEY=
TEKDOCS_PUBLICATION_SIGNING_KEY=
TEKDOCS_BOOTSTRAP_TOKEN=
TEKDOCS_SECRET_DIRECTORY=/run/tekdocs-secrets
TEKDOCS_PUBLIC_URL=https://docs.example.com
TEKDOCS_ALLOW_INSECURE_PUBLIC_URL=false
# Configure all four ordinary OIDC values together; the client secret comes from compose.oidc-secret.yml.
TEKDOCS_OIDC_PROVIDER_ID=
TEKDOCS_OIDC_PROVIDER_NAME=
TEKDOCS_OIDC_DISCOVERY_URL=
TEKDOCS_OIDC_CLIENT_ID=
TEKDOCS_OIDC_CLIENT_SECRET= # Supplied only through compose.oidc-secret.yml.
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TIMEOUT_SECONDS=3600
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=TekDocs <noreply@example.com>
TEKDOCS_ALLOW_INSECURE_SMTP=false
SECURE_SSL_REDIRECT=true
TZ=America/Chicago
